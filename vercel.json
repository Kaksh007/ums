{
  "version": 2,
  "devCommand": "node ./node_modules/@angular/cli/bin/ng.js serve --host 127.0.0.1 --port 4200",
  "buildCommand": "node ./node_modules/@angular/cli/bin/ng.js build",
  "outputDirectory": "dist/client/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
